# Mastodon API Configuration
# Replace with your Mastodon instance (e.g., mastodon.social)
MASTODON_INSTANCE=your-instance.social

# Your access token with read:statuses, write:statuses, and read:notifications scopes
# You can obtain this from your Mastodon instance's developer settings
MASTODON_ACCESS_TOKEN=your_access_token_here

# Logging Configuration
# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default is INFO if not specified
LOG_LEVEL=INFO
